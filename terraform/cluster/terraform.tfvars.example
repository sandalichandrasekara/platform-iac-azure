# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# The subscription comes from ARM_SUBSCRIPTION_ID in your environment.

project     = "platform"
environment = "dev"
location    = "eastus"

# Must be globally unique.
acr_name       = "platformdevacr001"
key_vault_name = "platform-dev-kv-001"

# Azure AD principal that administers Azure SQL (AAD-only auth).
sql_aad_admin_login     = "sql-admins"
sql_aad_admin_object_id = "00000000-0000-0000-0000-000000000000"

# AAD group(s) granted AKS cluster-admin. Required: local accounts are disabled.
aks_admin_group_object_ids = ["11111111-1111-1111-1111-111111111111"]

# Object id of the Terraform/CI service principal, granted RBAC cluster-admin so
# the k8s-base / k8s-extensions layers can reach the API. Leave "" to skip.
ci_principal_object_id = "22222222-2222-2222-2222-222222222222"

alert_email_receivers = {
  oncall = "oncall@example.com"
}

tags = {
  owner      = "platform-team"
  costCenter = "eng-platform"
}
