# Local .terraform directories
**/.terraform/*

# .tfstate files 
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files that may contain secrets or environment values.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files as they are usually used for local dev
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration and credential files
.terraformrc
terraform.rc
.terraform.lock.hcl.bak

# Plan output files
*.tfplan
plan.out

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Secrets
*.pem
*.key
.env
.env.*
!.env.example
